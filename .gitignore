# Ignore compiled object files and binaries
*.o
*.ko
*.obj
*.elf
*.out
*.so
*.a
*.la
*.lo
*.class
*.jar

# Ignore editor and environment-specific files
*~
.*.swp
.*.swo
.cache/
.ccls-cache/
.tags

# Ignore logs and temporary files
*.log
*.pid
*.seed
*.backup
*.bak
*.tmp
*.old
*.egg-info

# Ignore package manager-related directories
node_modules/
vendor/
target/
out/
dist/
build/
**/legacy/

# Ignore directories containing "results"
**/results*/
**/__pycache__*/
*.eps
*tmp*

# Local paper repository / manuscript artifacts
/LATEX-SSIR/

# Experiment outputs. Keep top-level revision scripts visible.
/revision/**
!/revision/
!/revision/*.py

# Generated figures, rendered media, and local model checkpoints
/scripts/graphs/*.pdf
/scripts/map/mp4_frames/
/scripts/map/*.mp4
/scripts/results_mmf_vs_*
/scripts/results_mmf_vs_*/
*.pt
*.pth
*.ckpt
*.pkl
